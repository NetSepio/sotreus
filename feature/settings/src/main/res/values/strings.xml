    <string name="confirm_session_title">Delete %1$s?</string>
    <string name="confirm_session_body">This removes the session’s observations, encounters, timeline, notes, phone locations and attention events from this phone. Commitments already published on Solana are not affected.</string>
    <string name="confirm_place_title">Delete history for %1$s?</string>
    <string name="confirm_place_body">This removes this place’s visits, baseline, encounters, observations and attention events. The place itself, your labels and notes stay.</string>
    <string name="confirm_presence_title">Delete friend-presence keys?</string>
    <string name="confirm_presence_body">This removes your friends list, every pairwise presence secret and this phone’s presence key, and turns Nearby presence off. Friends will need to pair again.</string>
    <string name="confirm_all_title">Delete all local observations?</string>
    <string name="confirm_all_body">This removes every observation, encounter, place visit, session timeline entry, phone location and attention event on this phone. Your places, entity labels, names and notes stay. This can’t be undone.</string>
    <string name="confirm_pending_title">Clear pending proof batches?</string>
    <string name="confirm_pending_body">This removes proof batches that were never submitted, with their salts and leaves. Finalized batches and receipts stay.</string>
