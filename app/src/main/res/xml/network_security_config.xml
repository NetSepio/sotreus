<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed only to a Sotreus Edge: its own access point and the .local names the app
     resolves itself over mDNS on a shared network. Everything else stays HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
